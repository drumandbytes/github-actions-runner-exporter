{
  "title": "GitHub Actions Runners & Org Health",
  "uid": "github-actions-runner-exporter",
  "description": "Dashboard for drumandbytes/github-actions-runner-exporter: runner online/busy state, CI health per workflow, job run/queue time history, open PRs, Dependabot alerts and API rate limit.",
  "tags": [
    "github",
    "github-actions",
    "prometheus"
  ],
  "schemaVersion": 39,
  "version": 7,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "links": [
    {
      "title": "github-actions-runner-exporter",
      "url": "https://github.com/drumandbytes/github-actions-runner-exporter",
      "type": "link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "org",
        "label": "GitHub org",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(github_org_info, org)",
          "refId": "org"
        },
        "definition": "label_values(github_org_info, org)",
        "refresh": 1,
        "hide": 2,
        "current": {}
      },
      {
        "name": "repo",
        "label": "Repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(github_job_run_seconds_count, repo)",
          "refId": "repo"
        },
        "definition": "label_values(github_job_run_seconds_count, repo)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "window",
        "label": "Rate window",
        "type": "custom",
        "query": "6h,1d,7d",
        "current": {
          "text": "1d",
          "value": "1d"
        },
        "options": [
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": true
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Runners",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Runners online",
      "description": "Registered runners currently online",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (runner) (github_runner_up))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Runners offline",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (runner) (github_runner_up) == 0) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Busy now",
      "description": "Runners executing a job",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (runner) (github_runner_busy))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Runner poll",
      "description": "0 means the exporter is serving a stale cache",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(github_runners_up)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "stale"
                },
                "1": {
                  "text": "ok"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Org stats poll",
      "description": "0 means org/repo stats are from a stale cache",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(github_org_up)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "stale"
                },
                "1": {
                  "text": "ok"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "id": 7,
      "title": "Runner Online",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "max by (runner, os) (github_runner_up)",
          "legendFormat": "{{runner}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Runner Busy",
      "type": "state-timeline",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Idle",
                  "color": "blue"
                },
                "1": {
                  "text": "Running job",
                  "color": "orange"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "max by (runner, os) (github_runner_busy)",
          "legendFormat": "{{runner}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Organization",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 9
    },
    {
      "id": 10,
      "title": "Public Repos",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "max by (visibility) (github_org_repos_total{visibility=\"public\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Private Repos",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "max by (visibility) (github_org_repos_total{visibility=\"private\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "API Rate Limit Remaining",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 200,
                "color": "yellow"
              },
              {
                "value": 1000,
                "color": "green"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(github_rate_limit_remaining)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Open PRs (Org-wide)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 25,
                "color": "red"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(max by (repo) (github_repo_open_prs))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "All open PRs in the org",
          "url": "https://github.com/pulls?q=is%3Aopen+is%3Apr+org%3A${org}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 14,
      "title": "Dependabot Alerts by Severity (Org-wide)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          },
          "noValue": "No open alerts"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 28,
        "text": {
          "titleSize": 14,
          "valueSize": 16
        },
        "namePlacement": "top"
      },
      "targets": [
        {
          "expr": "sum by (severity) (max by (repo, severity) (github_repo_dependabot_alerts_open))",
          "legendFormat": "{{severity}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "Open Dependabot alerts across the org. Click the title link for the list on GitHub.",
      "links": [
        {
          "title": "Dependabot alerts on GitHub",
          "url": "https://github.com/orgs/${org}/security/alerts/dependabot",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 25,
      "title": "Dependabot Alerts by Repo",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Open alerts per repo and severity. Click a repo to open its Dependabot alerts on GitHub.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "expr": "max by (repo, severity) (github_repo_dependabot_alerts_open)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "severity",
            "rowField": "repo",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "repo\\severity": "repo"
            },
            "indexByName": {
              "repo\\severity": 0,
              "critical": 1,
              "high": 2,
              "medium": 3,
              "low": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No open alerts",
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "repo"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Dependabot alerts in ${__data.fields.repo}",
                    "url": "https://github.com/${org}/${__data.fields.repo}/security/dependabot",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 15,
      "title": "Open PRs by Repo",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No open PRs",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "displayName": "${__field.labels.repo}",
          "links": [
            {
              "title": "Open PRs in ${__field.labels.repo}",
              "url": "https://github.com/${org}/${__field.labels.repo}/pulls",
              "targetBlank": true
            }
          ]
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "namePlacement": "top",
        "showUnfilled": true,
        "valueMode": "color",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 28,
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      },
      "targets": [
        {
          "expr": "max by (repo) (github_repo_open_prs) > 0",
          "legendFormat": "{{repo}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "Click a bar to open that repo's pull requests on GitHub.",
      "links": [
        {
          "title": "All open PRs in the org",
          "url": "https://github.com/pulls?q=is%3Aopen+is%3Apr+org%3A${org}",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 16,
      "title": "CI Health (per repo/workflow)",
      "description": "One row per repo/workflow, showing the raw GitHub conclusion (green success, red failure/timed_out/action_required, blue cancelled/skipped/stale, purple neutral) rather than a collapsed pass/fail. Latest completed run per workflow; run/queue time history is in the CI History row below.",
      "type": "table",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (repo, workflow, url, conclusion) (github_repo_ci_last_run_conclusion)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "max by (repo, workflow) (github_repo_ci_last_run_timestamp_seconds) * 1000",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "conclusion": "Status",
              "Value #B": "Last Run"
            },
            "indexByName": {
              "repo": 0,
              "workflow": 1,
              "Status": 2,
              "Last Run": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "text": "Passing",
                        "color": "green",
                        "index": 0
                      },
                      "failure": {
                        "text": "Failing",
                        "color": "red",
                        "index": 1
                      },
                      "timed_out": {
                        "text": "Timed Out",
                        "color": "red",
                        "index": 2
                      },
                      "action_required": {
                        "text": "Action Required",
                        "color": "orange",
                        "index": 3
                      },
                      "cancelled": {
                        "text": "Cancelled",
                        "color": "blue",
                        "index": 4
                      },
                      "skipped": {
                        "text": "Skipped",
                        "color": "blue",
                        "index": 5
                      },
                      "neutral": {
                        "text": "Neutral",
                        "color": "purple",
                        "index": 6
                      },
                      "stale": {
                        "text": "Stale",
                        "color": "blue",
                        "index": 7
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View run on GitHub",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
